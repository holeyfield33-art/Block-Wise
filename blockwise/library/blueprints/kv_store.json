{
 "id": "kv_store",
 "title": "Key-value store in a JSON file",
 "category": "blueprint",
 "summary": "A runnable settings/notes store: set, get, delete and list keys, saved to a JSON file between runs. One small function per command.",
 "params": {
  "file": {
   "kind": "identifier",
   "default": "store"
  },
  "store": {
   "kind": "string",
   "default": "store.json"
  }
 },
 "try": "python {path} set name Ana",
 "plan": {
  "modules": [
   {
    "path": "{{file}}.py",
    "imports": [
     "import json",
     "import sys"
    ],
    "constants": [
     {
      "name": "STORE",
      "value": "{{store}}"
     }
    ],
    "functions": [
     {
      "name": "load",
      "parameters": [
       {
        "name": "path",
        "type": "str"
       }
      ],
      "returns": "dict",
      "requirements": [
       "A missing or broken file means an empty store."
      ],
      "body": [
       {
        "kind": "try",
        "exception": "(OSError, ValueError)",
        "body": [
         {
          "kind": "with",
          "context": "open(path, encoding='utf-8')",
          "alias": "handle",
          "body": [
           {
            "kind": "return",
            "expression": "json.load(handle)"
           }
          ]
         }
        ],
        "handler": [
         {
          "kind": "return",
          "expression": "{}"
         }
        ]
       }
      ]
     },
     {
      "name": "save",
      "parameters": [
       {
        "name": "path",
        "type": "str"
       },
       {
        "name": "data",
        "type": "dict"
       }
      ],
      "returns": "None",
      "body": [
       {
        "kind": "with",
        "context": "open(path, 'w', encoding='utf-8')",
        "alias": "handle",
        "body": [
         {
          "kind": "call",
          "expression": "json.dump(data, handle, indent=2, sort_keys=True)"
         }
        ]
       }
      ]
     },
     {
      "name": "format_entries",
      "parameters": [
       {
        "name": "data",
        "type": "dict"
       }
      ],
      "returns": "str",
      "body": [
       {
        "kind": "branch",
        "condition": "not data",
        "body": [
         {
          "kind": "return",
          "expression": "'(empty)'"
         }
        ]
       },
       {
        "kind": "return",
        "expression": "'\\n'.join((f'{key} = {data[key]}' for key in sorted(data)))"
       }
      ]
     },
     {
      "name": "require_key",
      "parameters": [
       {
        "name": "data",
        "type": "dict"
       },
       {
        "name": "key",
        "type": "str"
       }
      ],
      "returns": "None",
      "body": [
       {
        "kind": "branch",
        "condition": "key not in data",
        "body": [
         {
          "kind": "raise",
          "expression": "LookupError(f'no key {key}')"
         }
        ]
       }
      ]
     },
     {
      "name": "set_value",
      "parameters": [
       {
        "name": "data",
        "type": "dict"
       },
       {
        "name": "key",
        "type": "str"
       },
       {
        "name": "value",
        "type": "str"
       }
      ],
      "returns": "int",
      "body": [
       {
        "kind": "call",
        "expression": "data.update({key: value})"
       },
       {
        "kind": "call",
        "expression": "save(STORE, data)"
       },
       {
        "kind": "call",
        "expression": "print(f'{key} saved.')"
       },
       {
        "kind": "return",
        "expression": "0"
       }
      ]
     },
     {
      "name": "get_value",
      "parameters": [
       {
        "name": "data",
        "type": "dict"
       },
       {
        "name": "key",
        "type": "str"
       }
      ],
      "returns": "int",
      "body": [
       {
        "kind": "validate",
        "expression": "require_key(data, key)"
       },
       {
        "kind": "call",
        "expression": "print(data[key])"
       },
       {
        "kind": "return",
        "expression": "0"
       }
      ]
     },
     {
      "name": "delete_value",
      "parameters": [
       {
        "name": "data",
        "type": "dict"
       },
       {
        "name": "key",
        "type": "str"
       }
      ],
      "returns": "int",
      "body": [
       {
        "kind": "validate",
        "expression": "require_key(data, key)"
       },
       {
        "kind": "call",
        "expression": "data.pop(key)"
       },
       {
        "kind": "call",
        "expression": "save(STORE, data)"
       },
       {
        "kind": "call",
        "expression": "print(f'{key} deleted.')"
       },
       {
        "kind": "return",
        "expression": "0"
       }
      ]
     },
     {
      "name": "main",
      "parameters": [
       {
        "name": "args",
        "type": "list"
       }
      ],
      "returns": "int",
      "requirements": [
       "Commands: set KEY VALUE, get KEY, delete KEY, list. Returns the exit code."
      ],
      "body": [
       {
        "kind": "assign",
        "target": "data",
        "expression": "load(STORE)"
       },
       {
        "kind": "try",
        "exception": "LookupError",
        "alias": "error",
        "body": [
         {
          "kind": "branch",
          "condition": "not args or args[0] == 'list'",
          "body": [
           {
            "kind": "call",
            "expression": "print(format_entries(data))"
           }
          ],
          "otherwise": [
           {
            "kind": "branch",
            "condition": "args[0] == 'set' and len(args) == 3",
            "body": [
             {
              "kind": "return",
              "expression": "set_value(data, args[1], args[2])"
             }
            ],
            "otherwise": [
             {
              "kind": "branch",
              "condition": "args[0] == 'get' and len(args) == 2",
              "body": [
               {
                "kind": "return",
                "expression": "get_value(data, args[1])"
               }
              ],
              "otherwise": [
               {
                "kind": "branch",
                "condition": "args[0] == 'delete' and len(args) == 2",
                "body": [
                 {
                  "kind": "return",
                  "expression": "delete_value(data, args[1])"
                 }
                ],
                "otherwise": [
                 {
                  "kind": "call",
                  "expression": "print('usage: {{file}}.py [set KEY VALUE | get KEY | delete KEY | list]')"
                 },
                 {
                  "kind": "return",
                  "expression": "2"
                 }
                ]
               }
              ]
             }
            ]
           }
          ]
         }
        ],
        "handler": [
         {
          "kind": "call",
          "expression": "print(f'error: {error}')"
         },
         {
          "kind": "return",
          "expression": "1"
         }
        ]
       },
       {
        "kind": "return",
        "expression": "0"
       }
      ]
     }
    ],
    "entry": [
     {
      "kind": "call",
      "expression": "sys.exit(main(sys.argv[1:]))"
     }
    ]
   }
  ]
 },
 "examples": [
  {
   "argv": [],
   "stdout": "(empty)\n",
   "exit": 0
  },
  {
   "argv": [
    "set",
    "name",
    "Ana"
   ],
   "stdout": "name saved.\n",
   "exit": 0
  },
  {
   "argv": [
    "set",
    "city",
    "Lisbon"
   ],
   "stdout": "city saved.\n",
   "exit": 0
  },
  {
   "argv": [
    "get",
    "name"
   ],
   "stdout": "Ana\n",
   "exit": 0
  },
  {
   "argv": [
    "list"
   ],
   "stdout": "city = Lisbon\nname = Ana\n",
   "exit": 0
  },
  {
   "argv": [
    "delete",
    "city"
   ],
   "stdout": "city deleted.\n",
   "exit": 0
  },
  {
   "argv": [
    "get",
    "city"
   ],
   "stdout": "error: no key city\n",
   "exit": 1
  },
  {
   "argv": [
    "set",
    "x"
   ],
   "stdout": "usage: store.py [set KEY VALUE | get KEY | delete KEY | list]\n",
   "exit": 2
  }
 ]
}
