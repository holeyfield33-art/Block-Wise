{
 "block": "url_allowlist",
 "note": "Deliberately weakened copies of the block, one control removed or done wrong in each. The probes must catch every one; a survivor means the probes have a blind spot.",
 "mutants": [
  {
   "id": "M1",
   "weakness": "allowlist by substring of the whole URL",
   "caught_by": [
    "P10",
    "P11"
   ],
   "replace": {
    "check_url": [
     {
      "kind": "branch",
      "condition": "not any((name in url for name in allowed_hosts))",
      "body": [
       {
        "kind": "raise",
        "expression": "ValueError('refused')"
       }
      ]
     },
     {
      "kind": "return",
      "expression": "url"
     }
    ]
   }
  },
  {
   "id": "M2",
   "weakness": "allowlist by suffix without a dot boundary",
   "caught_by": [
    "P9"
   ],
   "replace": {
    "check_url": [
     {
      "kind": "assign",
      "target": "host",
      "expression": "url_host(url)"
     },
     {
      "kind": "branch",
      "condition": "is_internal_host(host)",
      "body": [
       {
        "kind": "raise",
        "expression": "ValueError(f'refused: {host} is an internal or numeric address')"
       }
      ]
     },
     {
      "kind": "branch",
      "condition": "not any((host.endswith(name) for name in allowed_hosts))",
      "body": [
       {
        "kind": "raise",
        "expression": "ValueError('refused')"
       }
      ]
     },
     {
      "kind": "return",
      "expression": "url"
     }
    ]
   }
  },
  {
   "id": "M3",
   "weakness": "no internal-address guard (trusts the allowlist)",
   "caught_by": [
    "P2",
    "P3",
    "P4",
    "P5",
    "P6",
    "P7"
   ],
   "replace": {
    "check_url": [
     {
      "kind": "assign",
      "target": "host",
      "expression": "url_host(url)"
     },
     {
      "kind": "branch",
      "condition": "host not in [name.lower().rstrip('.') for name in allowed_hosts]",
      "body": [
       {
        "kind": "raise",
        "expression": "ValueError(f'refused: {host} is not on the allowlist')"
       }
      ]
     },
     {
      "kind": "return",
      "expression": "url"
     }
    ]
   }
  },
  {
   "id": "M4",
   "weakness": "internal guard only recognises IP literals",
   "caught_by": [
    "P5",
    "P6",
    "P7"
   ],
   "replace": {
    "is_internal_host": [
     {
      "kind": "return",
      "expression": "is_ip_literal(host)"
     }
    ]
   }
  },
  {
   "id": "M5",
   "weakness": "no check for control characters, spaces or backslashes",
   "caught_by": [
    "P16"
   ],
   "replace": {
    "url_host": [
     {
      "kind": "assign",
      "target": "parts",
      "expression": "urlsplit(url)"
     },
     {
      "kind": "branch",
      "condition": "parts.scheme not in ('http', 'https')",
      "body": [
       {
        "kind": "raise",
        "expression": "ValueError('refused: only http and https URLs are allowed')"
       }
      ]
     },
     {
      "kind": "branch",
      "condition": "parts.username is not None or parts.password is not None",
      "body": [
       {
        "kind": "raise",
        "expression": "ValueError('refused: the URL contains credentials')"
       }
      ]
     },
     {
      "kind": "assign",
      "target": "host",
      "expression": "(parts.hostname or '').rstrip('.')"
     },
     {
      "kind": "branch",
      "condition": "not host",
      "body": [
       {
        "kind": "raise",
        "expression": "ValueError('refused: the URL has no host')"
       }
      ]
     },
     {
      "kind": "assign",
      "target": "port",
      "expression": "parts.port"
     },
     {
      "kind": "return",
      "expression": "host"
     }
    ]
   }
  },
