[
  {
    "id": "require_role",
    "title": "Allow only certain roles",
    "category": "auth",
    "summary": "Raise PermissionError unless the role is one of the allowed roles.",
    "params": {
      "function": {
        "kind": "identifier",
        "default": "require_admin"
      },
      "role": {
        "kind": "identifier",
        "default": "role"
      },
      "allowed": {
        "kind": "string_list",
        "default": [
          "admin"
        ]
      }
    },
    "function": {
      "name": "{{function}}",
      "parameters": [
        {
          "name": "{{role}}",
          "type": "str"
        }
      ],
      "returns": "None",
      "body": [
        {
          "kind": "branch",
          "condition": "{{role}} not in {{allowed}}",
          "body": [
            {
              "kind": "raise",
              "expression": "PermissionError('role not allowed')"
            }
          ]
        },
        {
          "kind": "return",
          "expression": "None"
        }
      ]
    },
    "examples": [
      {
        "args": [
          "admin"
        ],
        "returns": null
      },
      {
        "args": [
          "guest"
        ],
        "raises": "PermissionError"
      }
    ]
  },
  {
    "id": "require_active_user",
    "title": "Block disabled accounts",
    "category": "auth",
    "summary": "Raise PermissionError unless user['active'] is exactly True (missing, 1 or 'yes' are refused).",
    "params": {
      "function": {
        "kind": "identifier",
        "default": "require_active"
      },
      "user": {
        "kind": "identifier",
        "default": "user"
      }
    },
    "function": {
      "name": "{{function}}",
      "parameters": [
        {
          "name": "{{user}}",
          "type": "dict"
        }
      ],
      "returns": "None",
      "body": [
        {
          "kind": "branch",
          "condition": "{{user}}.get('active') is not True",
          "body": [
            {
              "kind": "raise",
              "expression": "PermissionError('account disabled')"
            }
          ]
        },
        {
          "kind": "return",
          "expression": "None"
        }
      ]
    },
    "examples": [
      {
        "args": [
          {
            "active": true
          }
        ],
        "returns": null
      },
      {
        "args": [
          {
            "active": 1
          }
        ],
        "raises": "PermissionError"
      },
      {
        "args": [
          {}
        ],
        "raises": "PermissionError"
      }
    ]
  },
  {
    "id": "require_owner_or_role",
    "title": "Owner or privileged role only",
    "category": "auth",
    "summary": "Allow the resource owner or a privileged role; everyone else gets PermissionError.",
    "params": {
      "function": {
        "kind": "identifier",
        "default": "require_owner_or_admin"
      },
      "user": {
        "kind": "identifier",
        "default": "user"
      },
      "owner": {
        "kind": "identifier",
        "default": "owner"
      },
      "roles": {
        "kind": "string_list",
        "default": [
          "admin"
        ]
      }
    },
    "function": {
      "name": "{{function}}",
      "parameters": [
        {
          "name": "{{user}}",
          "type": "dict"
        },
        {
          "name": "{{owner}}",
          "type": "str"
        }
      ],
      "returns": "None",
      "body": [
        {
          "kind": "branch",
          "condition": "{{user}}.get('name') != {{owner}} and {{user}}.get('role') not in {{roles}}",
          "body": [
            {
              "kind": "raise",
              "expression": "PermissionError('not owner or privileged')"
            }
          ]
        },
        {
          "kind": "return",
          "expression": "None"
        }
      ]
    },
    "examples": [
      {
        "args": [
          {
            "name": "ann"
          },
          "ann"
        ],
        "returns": null
      },
      {
        "args": [
          {
            "name": "bo",
            "role": "admin"
          },
          "ann"
        ],
        "returns": null
      },
      {
        "args": [
          {
            "name": "bo",
            "role": "user"
          },
          "ann"
        ],
        "raises": "PermissionError"
      }
    ]
  },
  {
    "id": "checked_operation",
    "title": "Run checks, then do the work (fill-in)",
    "category": "auth",
    "summary": "Imports two existing check functions, calls them in order, then leaves one TODO for the actual work. Locks in 'validate, then authorize, then act'.",
    "params": {
      "function": {
        "kind": "identifier",
        "default": "process"
      },
      "value": {
        "kind": "identifier",
        "default": "amount"
      },
      "type": {
        "kind": "annotation",
        "default": "int"
      },
      "actor": {
        "kind": "identifier",
        "default": "role"
      },
      "first_check": {
        "kind": "identifier",
        "default": "require_positive"
      },
      "second_check": {
        "kind": "identifier",
        "default": "require_admin"
      },
      "module": {
        "kind": "module",
        "default": "checks",
        "help": "Module that defines both check functions, e.g. shop.checks"
      },
      "work": {
        "kind": "text",
        "default": "Set result from the validated value"
      }
    },
    "function": {
      "name": "{{function}}",
      "parameters": [
        {
          "name": "{{value}}",
          "type": "{{type}}"
        },
        {
          "name": "{{actor}}",
          "type": "str"
        }
      ],
      "returns": "{{type}}",
      "body": [
        {
          "kind": "validate",
          "expression": "{{first_check}}({{value}})"
        },
        {
          "kind": "call",
          "expression": "{{second_check}}({{actor}})"
        },
        {
          "kind": "hole",
          "label": "{{work}}",
          "allowed_calls": []
        },
        {
          "kind": "return",
          "expression": "result"
        }
      ]
    },
    "examples": [],
    "imports": [
      "from {{module}} import {{first_check}}, {{second_check}}"
    ]
  }
]
